# DocuMind configuration. Copy to backend/.env (or the repo root for docker compose)
# and fill in real values. NEVER commit real secrets.

# development | testing | production   (Render defaults to production automatically)
ENVIRONMENT=development
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production refuses to start with a default, known or <32-character key.
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Neon example: postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_intelligence

# Google Gemini (server-side only; never put this in the frontend)
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Exact frontend origin(s), comma-separated. Required in production. No wildcards.
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Upload limits
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=500
MAX_DOCUMENTS_PER_USER=50

# Optional: shared rate-limit store. Required if WEB_CONCURRENCY > 1.
REDIS_URL=
WEB_CONCURRENCY=1
